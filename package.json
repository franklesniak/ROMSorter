{
  "name": "romsorter",
  "version": "1.0.0",
  "description": "Development validation tools for ROMSorter PowerShell scripts",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.venv\" \"#.pytest_cache\" \"#**/.pytest_cache\"",
    "lint:md:links": "remark . --quiet --frail --ignore-path .remarkignore",
    "lint:md:nested": "node .github/scripts/lint-nested-markdown.js",
    "test:md:nested": "node --test .github/scripts/lint-nested-markdown.test.js",
    "test:toolchain-eol": "node --test tests/toolchain-eol/check-toolchain-eol.test.js"
  },
  "keywords": [
    "romsorter",
    "powershell",
    "rom"
  ],
  "author": "Frank Lesniak",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.7.1"
    }
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.2",
    "markdownlint": "^0.41.1",
    "markdownlint-cli2": "^0.23.3",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  }
}
